{$DUET_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 600KB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
    }
    reverse_proxy duet:8000 {
        transport http {
            response_header_timeout 30s
        }
    }
}
